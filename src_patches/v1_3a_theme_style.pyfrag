# ============================================================================
# Rice2k Macro Studio v1.3 - Mockup-Matched UI
# Rebuilds the application shell and Dashboard to match the approved concept.
# ============================================================================
APP_VERSION = "1.3 Mockup-Matched UI"

THEMES["dark"].update({
    "bg": "#06111F",
    "panel": "#0B1A2B",
    "panel2": "#071522",
    "panel3": "#10263D",
    "card": "#0A1929",
    "card_alt": "#0D2034",
    "text": "#F4F8FF",
    "sub": "#A6BED8",
    "accent": "#0B83FF",
    "accent_hover": "#2296FF",
    "accent_pressed": "#086DDA",
    "accent2": "#20D6C2",
    "warning": "#FFC53D",
    "danger": "#FF3B4D",
    "danger_hover": "#FF5968",
    "success": "#26DB7A",
    "border": "#204B73",
    "border_soft": "#173A5A",
    "input_bg": "#081423",
    "select_bg": "#145A96",
    "disabled_bg": "#142437",
    "disabled_fg": "#647A91",
})
THEMES["light"].update({
    "card": "#FFFFFF",
    "card_alt": "#F7FAFC",
    "border_soft": "#E6ECF2",
})


def _v13_build_style(self):
    c = self.colors()
    self.configure(bg=c["bg"])
    self.option_add("*Font", (self.ui_font, 10))
    self.option_add("*TCombobox*Listbox.font", (self.ui_font, 10))
    self.option_add("*Listbox.font", (self.ui_font, 10))

    self.style = ttk.Style()
    try:
        self.style.theme_use("clam")
    except Exception:
        pass

    base = (self.ui_font, 10)
    small = (self.ui_font, 9)
    bold = (self.ui_font, 10, "bold")

    self.style.configure("TFrame", background=c["bg"])
    self.style.configure("Panel.TFrame", background=c["panel"])
    self.style.configure("Panel2.TFrame", background=c["panel2"])
    self.style.configure("TLabel", background=c["bg"], foreground=c["text"], font=base)
    self.style.configure("Panel.TLabel", background=c["panel"], foreground=c["text"], font=base)
    self.style.configure("Panel2.TLabel", background=c["panel2"], foreground=c["text"], font=base)
    self.style.configure("Header.TLabel", background=c["bg"], foreground=c["text"], font=(self.ui_font, 22, "bold"))
    self.style.configure("Sub.TLabel", background=c["bg"], foreground=c["sub"], font=small)
    self.style.configure("Status.TLabel", background=c["panel"], foreground=c["accent"], font=(self.ui_font, 11, "bold"))
    self.style.configure("Warn.TLabel", background=c["panel"], foreground=c["warning"], font=bold)
    self.style.configure("Success.TLabel", background=c["panel"], foreground=c["success"], font=bold)
    self.style.configure("Help.TLabel", background=c["panel"], foreground=c["sub"], font=small)
    self.style.configure("Section.TLabel", background=c["panel"], foreground=c["text"], font=(self.ui_font, 14, "bold"))
    self.style.configure("Footer.TLabel", background=c["panel2"], foreground=c["sub"], font=small)

    def map_button(name, normal, hover, pressed, fg, pad=(10, 7), font=None):
        self.style.configure(
            name, font=font or bold, padding=pad, background=normal, foreground=fg,
            bordercolor=c["border"], focusthickness=1, focuscolor=c["border"]
        )
        self.style.map(
            name,
            background=[
                ("disabled", c["disabled_bg"]), ("pressed", pressed),
                ("active", hover), ("focus", hover)
            ],
            foreground=[
                ("disabled", c["disabled_fg"]), ("pressed", fg),
                ("active", fg), ("focus", fg)
            ],
            bordercolor=[
                ("active", c["accent"]), ("focus", c["accent"]), ("pressed", pressed)
            ],
        )

    map_button("TButton", c["panel3"], "#15314E", "#0D2136", c["text"], pad=(10, 6), font=base)
    map_button("Primary.TButton", c["accent"], c["accent_hover"], c["accent_pressed"], "#FFFFFF", pad=(12, 9))
    map_button("Accent.TButton", c["accent2"], "#53E4D5", "#17AE9E", "#06131F", pad=(10, 7))
    map_button("Danger.TButton", c["danger"], c["danger_hover"], "#D72B3A", "#FFFFFF", pad=(10, 7))

    self.style.configure("TCheckbutton", background=c["card"], foreground=c["text"], font=base, padding=(3, 3))
    self.style.map(
        "TCheckbutton",
        background=[("active", c["card"]), ("focus", c["card"]), ("disabled", c["card"])],
        foreground=[("disabled", c["disabled_fg"]), ("active", c["text"]), ("focus", c["text"])],
        indicatorcolor=[
            ("selected", c["accent"]), ("!selected", c["input_bg"]), ("disabled", c["disabled_bg"])
        ],
    )
    self.style.configure("TRadiobutton", background=c["card"], foreground=c["text"], font=base, padding=(3, 3))
    self.style.map(
        "TRadiobutton",
        background=[("active", c["card"]), ("focus", c["card"]), ("disabled", c["card"])],
        foreground=[("disabled", c["disabled_fg"]), ("active", c["text"]), ("focus", c["text"])],
        indicatorcolor=[
            ("selected", c["accent"]), ("!selected", c["input_bg"]), ("disabled", c["disabled_bg"])
        ],
    )

    self.style.configure("TEntry", fieldbackground=c["input_bg"], foreground=c["text"], insertcolor=c["text"], bordercolor=c["border"], padding=5)
    self.style.map(
        "TEntry",
        fieldbackground=[("disabled", c["disabled_bg"]), ("readonly", c["panel3"]), ("focus", c["input_bg"])],
        foreground=[("disabled", c["disabled_fg"]), ("readonly", c["text"])],
        bordercolor=[("focus", c["accent"]), ("active", c["accent"])],
    )

    self.style.configure("TSpinbox", fieldbackground=c["input_bg"], foreground=c["text"], arrowcolor=c["text"], bordercolor=c["border"], padding=4)
    self.style.map(
        "TSpinbox",
        fieldbackground=[("disabled", c["disabled_bg"]), ("readonly", c["panel3"]), ("focus", c["input_bg"])],
        foreground=[("disabled", c["disabled_fg"]), ("readonly", c["text"])],
        arrowcolor=[("disabled", c["disabled_fg"]), ("active", c["accent"])],
        bordercolor=[("focus", c["accent"]), ("active", c["accent"])],
    )

    self.style.configure("TCombobox", fieldbackground=c["input_bg"], background=c["panel3"], foreground=c["text"], arrowcolor=c["text"], bordercolor=c["border"], padding=4)
    self.style.map(
        "TCombobox",
        fieldbackground=[("disabled", c["disabled_bg"]), ("readonly", c["input_bg"]), ("focus", c["input_bg"])],
        background=[("active", c["panel3"]), ("pressed", c["panel3"]), ("readonly", c["input_bg"])],
        foreground=[("disabled", c["disabled_fg"]), ("readonly", c["text"])],
        selectbackground=[("readonly", c["select_bg"])],
        selectforeground=[("readonly", c["text"])],
        arrowcolor=[("disabled", c["disabled_fg"]), ("active", c["accent"])],
    )

    self.style.configure("TScale", background=c["card"], troughcolor=c["input_bg"], bordercolor=c["border"], lightcolor=c["accent"], darkcolor=c["accent"])
    self.style.map("TScale", background=[("active", c["accent"]), ("focus", c["accent"])])

    self.style.configure("Vertical.TScrollbar", background=c["panel3"], troughcolor=c["panel2"], bordercolor=c["panel2"], arrowcolor=c["sub"], width=10)
    self.style.map(
        "Vertical.TScrollbar",
        background=[("active", c["accent"]), ("pressed", c["accent_pressed"])],
        arrowcolor=[("active", "#FFFFFF"), ("pressed", "#FFFFFF")],
    )

    self.style.configure("TLabelframe", background=c["panel"], foreground=c["text"], bordercolor=c["border"], relief="solid")
    self.style.configure("TLabelframe.Label", background=c["panel"], foreground=c["text"], font=bold)

    self.style.configure(
        "Treeview", background=c["panel2"], fieldbackground=c["panel2"], foreground=c["text"],
        rowheight=26, bordercolor=c["border"], font=base
    )
    self.style.map("Treeview", background=[("selected", c["select_bg"])], foreground=[("selected", c["text"])])
    self.style.configure("Treeview.Heading", background=c["panel3"], foreground=c["text"], font=bold, padding=(6, 5))
    self.style.map("Treeview.Heading", background=[("active", c["accent_pressed"]), ("pressed", c["accent_pressed"])])

    self.option_add("*Listbox.background", c["panel2"])
    self.option_add("*Listbox.foreground", c["text"])
    self.option_add("*Listbox.selectBackground", c["select_bg"])
    self.option_add("*Listbox.selectForeground", c["text"])
    self.option_add("*Text.background", c["panel2"])
    self.option_add("*Text.foreground", c["text"])
    self.option_add("*Text.insertBackground", c["text"])
    self.option_add("*Text.selectBackground", c["select_bg"])
    self.option_add("*Text.selectForeground", c["text"])
