# ============================================================================
# Rice2k Macro Studio v1.5 - Standalone EXE Export
# Adds a self-contained Windows macro runner export built locally with PyInstaller.
# ============================================================================
import base64
import zlib
import shutil
import subprocess
import tempfile

APP_VERSION = "1.5 Standalone EXE Export"


def _v15_standalone_runner_source(self, actions, recording_name="Rice2k Macro"):
    raw = json.dumps(actions, ensure_ascii=False, separators=(",", ":")).encode("utf-8")
    payload = base64.b64encode(zlib.compress(raw, 9)).decode("ascii")
    safe_title = str(recording_name or "Rice2k Macro").replace("\\", " ").replace('"', "'")
    template = r"""# Standalone macro runner exported by Rice2k Macro Studio.
# Emergency stop: press Esc or move the mouse to the upper-left corner.
import base64
import ctypes
import json
import os
import sys
import threading
import time
import tkinter as tk
from tkinter import ttk, messagebox
import zlib

import pyautogui
try:
    from pynput import keyboard as pynput_keyboard
except Exception:
    pynput_keyboard = None

APP_TITLE = __APP_TITLE_REPR__
PAYLOAD = __PAYLOAD_REPR__
ACTIONS = json.loads(zlib.decompress(base64.b64decode(PAYLOAD)).decode("utf-8"))

pyautogui.FAILSAFE = True
pyautogui.PAUSE = 0
stop_event = threading.Event()
pause_event = threading.Event()
worker = None
held_keys = set()
held_buttons = set()


def virtual_screen():
    try:
        u = ctypes.windll.user32
        return {"left": u.GetSystemMetrics(76), "top": u.GetSystemMetrics(77), "width": u.GetSystemMetrics(78), "height": u.GetSystemMetrics(79)}
    except Exception:
        w, h = pyautogui.size()
        return {"left": 0, "top": 0, "width": int(w), "height": int(h)}


def map_point(a):
    cur = virtual_screen()
    rw = int(a.get("virtual_width") or cur["width"] or 1)
    rh = int(a.get("virtual_height") or cur["height"] or 1)
    rl = int(a.get("virtual_left") or 0)
    rt = int(a.get("virtual_top") or 0)
    nx = (int(a.get("x", 0)) - rl) / rw
    ny = (int(a.get("y", 0)) - rt) / rh
    x = cur["left"] + round(nx * cur["width"])
    y = cur["top"] + round(ny * cur["height"])
    x = max(cur["left"], min(cur["left"] + cur["width"] - 1, x))
    y = max(cur["top"], min(cur["top"] + cur["height"] - 1, y))
    return x, y


def normalize_key(key, kind):
    if not key:
        return ""
    if kind == "char":
        return key.lower() if len(key) == 1 and key.isalpha() else key
    mapping = {
        "space":"space","enter":"enter","tab":"tab","backspace":"backspace","delete":"delete",
        "shift":"shift","shift_l":"shift","shift_r":"shift","ctrl":"ctrl","ctrl_l":"ctrl","ctrl_r":"ctrl",
        "alt":"alt","alt_l":"alt","alt_r":"alt","cmd":"win","cmd_l":"win","cmd_r":"win",
        "up":"up","down":"down","left":"left","right":"right","home":"home","end":"end",
        "page_up":"pageup","page_down":"pagedown","caps_lock":"capslock","esc":"esc",
    }
    key = str(key)
    if key.startswith("f") and key[1:].isdigit():
        return key
    return mapping.get(key, key)


def release_inputs():
    for k in list(held_keys):
        try: pyautogui.keyUp(k)
        except Exception: pass
    held_keys.clear()
    for b in list(held_buttons):
        try: pyautogui.mouseUp(button=b)
        except Exception: pass
    held_buttons.clear()


def set_status(text):
    try: root.after(0, status_var.set, text)
    except Exception: pass


def wait_interruptible(seconds):
    end = time.monotonic() + max(0.0, float(seconds))
    while time.monotonic() < end:
        if stop_event.is_set(): return False
        while pause_event.is_set() and not stop_event.is_set():
            time.sleep(0.05)
        time.sleep(min(0.03, max(0.0, end - time.monotonic())))
    return not stop_event.is_set()


def playback_thread():
    try:
        speed = max(0.05, float(speed_var.get()))
        repeats = max(1, int(repeat_var.get()))
        between = max(0.0, float(delay_var.get()))
        set_status("Playing")
        for run in range(repeats):
            if stop_event.is_set(): break
            for a in ACTIONS:
                if stop_event.is_set(): break
                while pause_event.is_set() and not stop_event.is_set():
                    time.sleep(0.05)
                if not wait_interruptible(float(a.get("time_since_last", 0) or 0) / speed): break
                typ = a.get("type")
                if typ == "move":
                    x, y = map_point(a); pyautogui.moveTo(x, y, duration=0)
                elif typ == "click":
                    x, y = map_point(a); pyautogui.moveTo(x, y, duration=0)
                    b = a.get("button", "left") or "left"
                    if a.get("pressed"):
                        pyautogui.mouseDown(button=b); held_buttons.add(b)
                    else:
                        pyautogui.mouseUp(button=b); held_buttons.discard(b)
                elif typ == "scroll":
                    x, y = map_point(a); pyautogui.moveTo(x, y, duration=0)
                    dy = int(a.get("dy", 0) or 0); dx = int(a.get("dx", 0) or 0)
                    if dy: pyautogui.scroll(dy, x=x, y=y)
                    if dx and hasattr(pyautogui, "hscroll"): pyautogui.hscroll(dx, x=x, y=y)
                elif typ == "key":
                    k = normalize_key(a.get("key", ""), a.get("key_kind", "special"))
                    if k:
                        if a.get("pressed"):
                            pyautogui.keyDown(k); held_keys.add(k)
                        else:
                            pyautogui.keyUp(k); held_keys.discard(k)
            if run + 1 < repeats and between and not stop_event.is_set():
                set_status(f"Waiting {between:g}s")
                if not wait_interruptible(between): break
                set_status("Playing")
        set_status("Stopped" if stop_event.is_set() else "Ready")
    except pyautogui.FailSafeException:
        set_status("Emergency stop (mouse failsafe)")
    except Exception as exc:
        set_status("Error")
        try: root.after(0, messagebox.showerror, "Playback Error", str(exc))
        except Exception: pass
    finally:
        release_inputs(); pause_event.clear(); stop_event.clear()


def play():
    global worker
    if worker and worker.is_alive(): return
    stop_event.clear(); pause_event.clear()
    worker = threading.Thread(target=playback_thread, daemon=True)
    worker.start()


def pause_resume():
    if pause_event.is_set():
        pause_event.clear(); set_status("Playing")
    else:
        pause_event.set(); set_status("Paused")


def stop():
    stop_event.set(); pause_event.clear(); set_status("Stopping")


def on_close():
    stop(); release_inputs(); root.destroy()


def esc_press(key):
    try:
        if pynput_keyboard is not None and key == pynput_keyboard.Key.esc:
            stop()
    except Exception:
        pass


root = tk.Tk()
root.title(APP_TITLE + " - Rice2k Macro Runner")
try:
    base = getattr(sys, "_MEIPASS", os.path.dirname(sys.executable))
    icon_file = os.path.join(base, "rice2k_macro_studio.ico")
    if os.path.exists(icon_file):
        root.iconbitmap(icon_file)
except Exception:
    pass
root.geometry("530x330")
root.minsize(480, 300)
root.configure(bg="#08111F")
root.protocol("WM_DELETE_WINDOW", on_close)
root.bind("<Escape>", lambda _e: stop())
style = ttk.Style(root)
try: style.theme_use("clam")
except Exception: pass
style.configure("TFrame", background="#08111F")
style.configure("TLabel", background="#08111F", foreground="#EEF5FF")
style.configure("TButton", padding=(10, 7), background="#10243A", foreground="#EEF5FF")
style.map("TButton", background=[("active", "#164C7D"), ("pressed", "#0D72D8")], foreground=[("active", "#FFFFFF"), ("pressed", "#FFFFFF")])
style.configure("Accent.TButton", padding=(10, 7), background="#178BFF", foreground="#FFFFFF")
style.map("Accent.TButton", background=[("active", "#2C9BFF"), ("pressed", "#0D72D8")])
style.configure("Danger.TButton", padding=(10, 7), background="#FF4D5A", foreground="#FFFFFF")
style.map("Danger.TButton", background=[("active", "#FF6671"), ("pressed", "#D93643")])
frame = ttk.Frame(root, padding=18); frame.pack(fill="both", expand=True)
ttk.Label(frame, text=APP_TITLE, font=("Segoe UI", 16, "bold")).grid(row=0, column=0, columnspan=4, sticky="w", pady=(0, 4))
ttk.Label(frame, text=f"Standalone macro • {len(ACTIONS)} recorded actions", foreground="#94B1D0").grid(row=1, column=0, columnspan=4, sticky="w", pady=(0, 14))
status_var = tk.StringVar(value="Ready")
ttk.Label(frame, text="Status:").grid(row=2, column=0, sticky="w", pady=5)
ttk.Label(frame, textvariable=status_var, foreground="#39D4C4").grid(row=2, column=1, columnspan=3, sticky="w", pady=5)
speed_var = tk.DoubleVar(value=1.0); repeat_var = tk.IntVar(value=1); delay_var = tk.DoubleVar(value=0.0)
ttk.Label(frame, text="Speed").grid(row=3, column=0, sticky="w", pady=5)
ttk.Spinbox(frame, from_=0.05, to=100.0, increment=0.25, textvariable=speed_var, width=10).grid(row=3, column=1, sticky="w", pady=5)
ttk.Label(frame, text="Repeat count").grid(row=4, column=0, sticky="w", pady=5)
ttk.Spinbox(frame, from_=1, to=999, textvariable=repeat_var, width=10).grid(row=4, column=1, sticky="w", pady=5)
ttk.Label(frame, text="Delay between runs (s)").grid(row=5, column=0, sticky="w", pady=5)
ttk.Spinbox(frame, from_=0, to=99999, increment=1, textvariable=delay_var, width=10).grid(row=5, column=1, sticky="w", pady=5)
buttons = ttk.Frame(frame); buttons.grid(row=6, column=0, columnspan=4, sticky="ew", pady=(18, 8))
ttk.Button(buttons, text="Play", style="Accent.TButton", command=play).pack(side="left", padx=(0, 6))
ttk.Button(buttons, text="Pause / Resume", command=pause_resume).pack(side="left", padx=6)
ttk.Button(buttons, text="Stop", style="Danger.TButton", command=stop).pack(side="left", padx=6)
ttk.Button(buttons, text="Exit", command=on_close).pack(side="right", padx=(6, 0))
ttk.Label(frame, text="Emergency stop: Esc or move the mouse to the upper-left corner.", foreground="#FFC857").grid(row=7, column=0, columnspan=4, sticky="w", pady=(8, 0))
if pynput_keyboard is not None:
    try:
        listener = pynput_keyboard.Listener(on_press=esc_press); listener.daemon = True; listener.start()
    except Exception:
        listener = None
root.mainloop()
"""
    return template.replace("__APP_TITLE_REPR__", repr(safe_title)).replace("__PAYLOAD_REPR__", repr(payload))


def _v15_safe_exe_name(self):
    source = Path(self.engine.current_file).stem if self.engine.current_file else "Rice2k_Macro"
    source = re.sub(r"[^A-Za-z0-9._ -]+", "_", source).strip(" ._") or "Rice2k_Macro"
    return source[:80]


def _v15_exe_builder_python_command(self):
    if not getattr(sys, "frozen", False):
        return [sys.executable]
    candidates = []
    py_launcher = shutil.which("py")
    if py_launcher:
        candidates.append([py_launcher, "-3"])
    python_exe = shutil.which("python")
    if python_exe:
        candidates.append([python_exe])
    for candidate in candidates:
        try:
            check = subprocess.run(candidate + ["-c", "import sys; print(sys.executable)"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=15)
            if check.returncode == 0:
                return candidate
        except Exception:
            continue
    raise RuntimeError("Standalone EXE export needs a local Python installation with PyInstaller. Install Python 3 and run Run_Setup_Diagnostics.bat, or run Rice2k Macro Studio through its Python launcher.")


def _v15_finish_exe_export(self, progress, success, message, path=None, log_path=None):
    try:
        progress.destroy()
    except Exception:
        pass
    if success:
        self.add_log(f"Standalone EXE exported: {path}")
        messagebox.showinfo("Standalone EXE Complete", f"Built successfully:\n{path}\n\nBuild log:\n{log_path}")
    else:
        log_error("export_standalone_exe", RuntimeError(message), extra=f"build_log={log_path}")
        messagebox.showerror("Standalone EXE Build Failed", f"{message}\n\nBuild log:\n{log_path}")


def _v15_export_standalone_exe(self, actions):
    if not sys.platform.startswith("win"):
        messagebox.showwarning("Windows EXE Export", "Standalone EXE export must be run from Rice2k Macro Studio on Windows.")
        return
    ensure_folders()
    notes = []
    if any(a.get("type") == "key" for a in actions):
        notes.append("• Recorded keyboard input is embedded inside the exported EXE.")
    if any(a.get("dynamic_rule") or a.get("control_name") or a.get("automation_id") for a in actions):
        notes.append("• Smart Target / dynamic-date metadata is preserved in the recording, but this standalone runner replays the recorded desktop coordinates.")
    if getattr(self, "browser_capture_actions", None):
        notes.append("• Imported Browser Smart Capture actions are not embedded in this EXE; export Smart JSON/CSV for those semantic browser actions.")
    if notes:
        note_text = "Standalone EXE notes:\n\n" + "\n".join(notes) + "\n\nContinue building the EXE?"
        if not messagebox.askyesno("Standalone EXE Export", note_text):
            return
    default_name = self._safe_exe_name()
    target = filedialog.asksaveasfilename(title="Export Standalone Macro EXE", initialdir=EXPORTS_DIR, initialfile=default_name + ".exe", defaultextension=".exe", filetypes=[("Windows executable", "*.exe")])
    if not target:
        return
    target = Path(target)
    if target.suffix.lower() != ".exe":
        target = target.with_suffix(".exe")
    workspace = EXPORTS_DIR / "EXE Builds" / f"{target.stem}_{now_stamp()}"
    workspace.mkdir(parents=True, exist_ok=True)
    runner = workspace / "standalone_macro_runner.py"
    runner.write_text(self._standalone_runner_source(actions, target.stem), encoding="utf-8")
    log_path = workspace / "exe_build.log"
    progress = tk.Toplevel(self)
    progress.title("Building Standalone EXE")
    progress.geometry("520x180")
    progress.resizable(False, False)
    progress.transient(self); progress.grab_set()
    c = self.colors(); progress.configure(bg=c["bg"])
    ttk.Label(progress, text="Building Standalone EXE", style="Header.TLabel").pack(anchor="w", padx=18, pady=(16, 4))
    ttk.Label(progress, text="PyInstaller is packaging the recording. This can take a minute on the first build.", style="Sub.TLabel", wraplength=470).pack(anchor="w", padx=18, pady=(0, 10))
    bar = ttk.Progressbar(progress, mode="indeterminate", length=470); bar.pack(padx=18, pady=8); bar.start(12)
    ttk.Label(progress, text=f"Build log: {log_path}", style="Sub.TLabel", wraplength=470).pack(anchor="w", padx=18, pady=(5, 0))
    def worker():
        try:
            py_cmd = self._exe_builder_python_command()
            version = subprocess.run(py_cmd + ["-m", "PyInstaller", "--version"], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, timeout=30)
            if version.returncode != 0:
                raise RuntimeError("PyInstaller is not available in the detected Python environment. Run Run_Setup_Diagnostics.bat or reinstall requirements.txt.")
            dist = workspace / "dist"; build = workspace / "build"; spec = workspace / "spec"
            dist.mkdir(exist_ok=True); build.mkdir(exist_ok=True); spec.mkdir(exist_ok=True)
            cmd = py_cmd + ["-m", "PyInstaller", "--clean", "--noconfirm", "--onefile", "--windowed", "--name", target.stem, "--distpath", str(dist), "--workpath", str(build), "--specpath", str(spec)]
            icon = Path(resource_path("rice2k_macro_studio.ico"))
            if icon.exists():
                cmd += ["--icon", str(icon), "--add-data", str(icon) + ";."]
            cmd.append(str(runner))
            env = os.environ.copy(); env["PYTHONUTF8"] = "1"
            proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, env=env)
            log_path.write_text("Rice2k Macro Studio Standalone EXE Build\n" + f"Time: {datetime.datetime.now().isoformat()}\nCommand: {' '.join(cmd)}\n\n{proc.stdout}", encoding="utf-8", errors="replace")
            built = dist / (target.stem + ".exe")
            if proc.returncode != 0 or not built.exists():
                raise RuntimeError(f"PyInstaller returned exit code {proc.returncode}. See the build log for details.")
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(built, target)
            self.after(0, self._finish_exe_export, progress, True, "", target, log_path)
        except Exception as exc:
            try:
                if not log_path.exists():
                    log_path.write_text(f"Build failed before PyInstaller completed.\n\n{type(exc).__name__}: {exc}\n", encoding="utf-8")
            except Exception:
                pass
            self.after(0, self._finish_exe_export, progress, False, str(exc), None, log_path)
    threading.Thread(target=worker, daemon=True, name="StandaloneEXEBuilder").start()


def _v15_show_exports(self):
    self.current_screen.set("Exports")
    self.clear_content()
    f = self.scroll_frame(self.panel())
    f.columnconfigure((0, 1), weight=1)
    ttk.Label(f, text="Export Recording", style="Panel.TLabel", font=(self.ui_font, 13, "bold")).grid(row=0, column=0, columnspan=2, sticky="w", padx=12, pady=(9, 3))
    self.help_text(f, "Exports never modify the original recording. Choose a format depending on whether you want backup, readability, spreadsheet analysis, editable automation code, or a standalone Windows runner.", 1, columnspan=2)
    formats = [
        ("json", "Raw JSON", "Best for backup/import. Preserves every recorded action and metadata."),
        ("txt", "Readable TXT", "Human-readable action list for troubleshooting and documentation."),
        ("csv", "Raw CSV", "Spreadsheet-friendly raw action data for Excel or analysis."),
        ("python", "Python Script", "Readable PyAutoGUI-style playback script for manual customization."),
        ("exe", "Standalone EXE", "Build a self-contained Windows macro runner with Play, Pause, Stop, speed, repeats, delay, and Esc emergency stop."),
        ("smart_json", "Smart Actions JSON", "Cleaned clicks, text blocks, scroll actions, and special keys."),
        ("smart_csv", "Smart Actions CSV", "Cleaned Smart Actions in spreadsheet-friendly form."),
    ]
    row = 2
    for fmt, title, desc in formats:
        box = ttk.LabelFrame(f, text=title)
        box.grid(row=row, column=0, columnspan=2, sticky="ew", padx=12, pady=4)
        box.columnconfigure(0, weight=1)
        ttk.Label(box, text=desc, style="Help.TLabel", wraplength=700, justify="left").grid(row=0, column=0, sticky="w", padx=12, pady=9)
        b = ttk.Button(box, text=f"Export {title}", style="Accent.TButton", command=lambda x=fmt: self.export_current(x))
        b.grid(row=0, column=1, sticky="e", padx=12, pady=9)
        self.tip(b, desc)
        row += 1
    b_open = ttk.Button(f, text="Open Exports Folder", command=lambda: open_folder(EXPORTS_DIR))
    b_open.grid(row=row, column=0, sticky="ew", padx=18, pady=12)
    self.tip(b_open, "Open Documents\\Rice2k Macro Studio\\Exports in File Explorer.")
    b_load = ttk.Button(f, text="Load Another Recording", command=self.choose_recording)
    b_load.grid(row=row, column=1, sticky="ew", padx=18, pady=12)
    self.tip(b_load, "Choose another recording to export.")


def _v15_export_current(self, export_format):
    actions = self.engine.snapshot_actions()
    if not actions:
        messagebox.showwarning("No Recording Loaded", "Record something or load a saved recording first.")
        return
    try:
        smart = build_smart_actions(actions)
        browser_smart = self.browser_smart_actions() if hasattr(self, "browser_smart_actions") else []
        combined_smart = smart + browser_smart
        if export_format == "json":
            path = self._export_path("recording", ".json")
            payload = {"app": APP_NAME, "version": APP_VERSION, "exported": datetime.datetime.now().isoformat(), "source": self.engine.current_file, "actions": actions, "smart_actions": smart, "browser_capture_actions": list(self.browser_capture_actions)}
            path.write_text(json.dumps(payload, indent=2, ensure_ascii=False), encoding="utf-8")
        elif export_format == "txt":
            path = self._export_path("recording_readable", ".txt")
            lines = [f"{APP_NAME} {APP_VERSION}", f"Exported: {datetime.datetime.now().isoformat()}", f"Source: {self.engine.current_file or 'current unsaved memory'}", f"Raw actions: {len(actions)}", f"Smart actions: {len(smart)}", ""]
            for i, a in enumerate(actions):
                lines.append(f"{i:05d} | {a.get('type','')} | t={a.get('time_from_start',0)} | window={a.get('window_title','')} | process={a.get('process_name','')} | target={a.get('control_type','')}:{a.get('control_name','')} | automation_id={a.get('automation_id','')} | dynamic={a.get('dynamic_rule','')} | x={a.get('x','')} y={a.get('y','')} | key={a.get('key','')} | scroll=({a.get('dx','')},{a.get('dy','')})")
            path.write_text("\n".join(lines), encoding="utf-8")
        elif export_format == "csv":
            path = self._export_path("recording_raw", ".csv")
            rows = [self._flatten_action_for_csv(a) for a in actions]
            fields = sorted({k for row in rows for k in row.keys()})
            with path.open("w", newline="", encoding="utf-8-sig") as f:
                writer = csv.DictWriter(f, fieldnames=fields); writer.writeheader(); writer.writerows(rows)
        elif export_format == "smart_json":
            path = self._export_path("smart_actions", ".json")
            path.write_text(json.dumps(combined_smart, indent=2, ensure_ascii=False), encoding="utf-8")
        elif export_format == "smart_csv":
            path = self._export_path("smart_actions", ".csv")
            rows = [self._flatten_action_for_csv(a) for a in combined_smart]
            fields = sorted({k for row in rows for k in row.keys()})
            with path.open("w", newline="", encoding="utf-8-sig") as f:
                writer = csv.DictWriter(f, fieldnames=fields); writer.writeheader(); writer.writerows(rows)
        elif export_format == "python":
            path = self._export_path("playback", ".py")
            payload = repr(actions)
            script = ('"""Exported by Rice2k Macro Studio. Review before running."""\nimport time\nimport pyautogui\n\n' + f'ACTIONS = {payload}\n' + 'SPEED = 1.0\n\n' + 'for a in ACTIONS:\n    time.sleep(max(0, float(a.get("time_since_last", 0))) / SPEED)\n    t = a.get("type")\n    if t == "move":\n        pyautogui.moveTo(a.get("x",0), a.get("y",0), duration=0)\n    elif t == "click":\n        pyautogui.moveTo(a.get("x",0), a.get("y",0), duration=0)\n        fn = pyautogui.mouseDown if a.get("pressed") else pyautogui.mouseUp\n        fn(button=a.get("button","left"))\n    elif t == "scroll":\n        pyautogui.moveTo(a.get("x",0), a.get("y",0), duration=0)\n        pyautogui.scroll(int(a.get("dy",0)))\n    elif t == "key":\n        key = a.get("key","")\n        if key:\n            fn = pyautogui.keyDown if a.get("pressed") else pyautogui.keyUp\n            fn(key.lower() if len(key)==1 else key)\n')
            path.write_text(script, encoding="utf-8")
        elif export_format == "exe":
            self.export_standalone_exe(actions)
            return
        else:
            raise ValueError(f"Unknown export format: {export_format}")
        self.add_log(f"Exported {export_format}: {path}")
        messagebox.showinfo("Export Complete", f"Saved:\n{path}")
    except Exception as exc:
        log_error("export_current", exc, extra=f"format={export_format}")
        messagebox.showerror("Export Error", f"{exc}\n\nDetails were written to the error log.")


