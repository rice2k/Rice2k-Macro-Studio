    self.style.configure("TSpinbox", fieldbackground=c["input_bg"], foreground=c["text"], arrowcolor=c["text"], bordercolor=c["border"], padding=4)
    self.style.map("TSpinbox", fieldbackground=[("disabled", c["disabled_bg"]), ("readonly", c["panel3"]), ("focus", c["input_bg"])], foreground=[("disabled", c["disabled_fg"]), ("readonly", c["text"])], arrowcolor=[("disabled", c["disabled_fg"]), ("active", c["accent"])], bordercolor=[("focus", c["accent"]), ("active", c["accent"])])
