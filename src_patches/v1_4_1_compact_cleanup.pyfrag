        "danger_hover": "#FF6671", "success": "#35D487", "border": "#21496D", "border_soft": "#17344F",
        "input_bg": "#091523", "select_bg": "#164C7D", "disabled_bg": "#152438",
        "disabled_fg": "#5F7790"
    },
    "light": {
        "bg": "#E8EEF5", "panel": "#F7FAFD", "panel2": "#EDF3F9",
        "panel3": "#DCE7F2", "card": "#F2F6FB", "text": "#18324B", "sub": "#5D7288",
        "accent": "#0E7C86", "accent_hover": "#15939E", "accent_pressed": "#0B6B74",
        "accent2": "#36CFA2", "warning": "#8D6400", "danger": "#B84A61",
        "danger_hover": "#C96076", "success": "#21895F", "border": "#C8D8E7", "border_soft": "#D9E4EF",
        "input_bg": "#FFFFFF", "select_bg": "#D6E9F7", "disabled_bg": "#E4EBF2",
        "disabled_fg": "#8A98A6"
    },
    "neo_green": {
        "bg": "#06110C", "panel": "#0A1A14", "panel2": "#08140F",
        "panel3": "#0F2B1E", "card": "#0B1E15", "text": "#D8FFE8", "sub": "#7DBA98",
        "accent": "#39FF88", "accent_hover": "#5DFF9E", "accent_pressed": "#20D66F",
        "accent2": "#00E5A8", "warning": "#D6FF57", "danger": "#FF5C75",
        "danger_hover": "#FF768B", "success": "#45E7A1", "border": "#1D6A45", "border_soft": "#133E2A",
