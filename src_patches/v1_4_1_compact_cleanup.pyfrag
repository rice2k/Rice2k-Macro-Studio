def _v141_show_recordings(self):
    self.current_screen.set("Recordings")
    self.clear_content()
    f = self.scroll_frame(self.panel())
    f.columnconfigure(0, weight=1)
    body = ttk.Frame(f, style="Panel.TFrame")
    body.grid(row=0, column=0, pady=4)
    body.columnconfigure(0, weight=1)

    ttk.Label(body, text="Saved Recordings", style="Section.TLabel").grid(row=0, column=0, sticky="w", padx=12, pady=(4, 2))
    ttk.Label(body, text="Load, replay, recover, or export saved recordings. Selecting a file does not run it until you press Play.", style="Help.TLabel", wraplength=920, justify="left").grid(row=1, column=0, sticky="w", padx=12, pady=(0, 4))

    list_card = ttk.LabelFrame(body, text="Recording Library")
    list_card.grid(row=2, column=0, sticky="ew", padx=12, pady=4)
    list_card.columnconfigure(0, weight=1)
    list_card.rowconfigure(0, weight=1)
    self.recording_list = tk.Listbox(
        list_card,
        height=14,
        bg=self.colors()["panel2"],
        fg=self.colors()["text"],
        selectbackground=self.colors()["accent"],
        selectforeground=("#06131F" if self.theme_var.get() == "neo_green" else self.colors()["text"]),
        font=(self.mono_font, 9),
        relief="flat",
        highlightthickness=0,
        activestyle="none",
    )
    self.recording_list.grid(row=0, column=0, sticky="nsew", padx=(10, 0), pady=10)
    self.tip(self.recording_list, "Saved recording files. Select one, then use Load, Play, or Export Selected.")
    sb = ttk.Scrollbar(list_card, orient="vertical", command=self.recording_list.yview, style="Vertical.TScrollbar")
    sb.grid(row=0, column=1, sticky="ns", padx=(0, 10), pady=10)
    self.recording_list.configure(yscrollcommand=sb.set)

    bar = ttk.Frame(body, style="Panel.TFrame")
    bar.grid(row=3, column=0, sticky="ew", padx=12, pady=(2, 8))
    buttons = [
        ("Refresh", self.refresh_recordings, "Refresh the list from the Recordings folder."),
        ("Load", self.load_selected, "Load the selected recording into memory without playing it."),
        ("Play", self.play_selected, "Load the selected recording and open the playback confirmation screen."),
        ("Export Selected", self.export_selected_recording, "Load the selected recording and open the Export page."),
        ("Recover Journal", self.recover_journal, "Recover actions from the incremental crash-recovery journal."),
        ("Open Folder", lambda: open_folder(RECORDINGS_DIR), "Open the Recordings folder in File Explorer."),
    ]
    for label, cmd, hint in buttons:
        b = ttk.Button(bar, text=label, command=cmd)
        b.pack(side="left", padx=4)
        self.tip(b, hint)
    self.refresh_recordings()


def _v141_show_automation(self):
    self.current_screen.set("Automation")
    self.clear_content()
    outer = self.scroll_frame(self.panel())
    outer.columnconfigure(0, weight=1)
    body = ttk.Frame(outer, style="Panel.TFrame")
    body.grid(row=0, column=0, pady=6)
    body.columnconfigure(0, weight=1)

    ttk.Label(body, text="Automation Mode", style="Section.TLabel").grid(row=0, column=0, sticky="w", padx=12, pady=(6, 2))
    self.help_text(body, "Modes are presets. They change what gets recorded and how strictly playback watches the target application.", 1, columnspan=1, wrap=960)

    row = 2
    modes = [
        ("click_fast", "Click-Only Fast", "Best default: clicks + scroll + optional keyboard, without noisy mouse movement."),
        ("physical", "Physical Replay", "Records/replays physical mouse movement, clicks, scroll, and optional keyboard."),
        ("browser", "Browser Element Capture", "Creates a bookmarklet helper that captures URL/title/role/labels/selectors without input values."),
        ("window_aware", "Window-Aware", "Uses process/window metadata and pauses if the target changes."),
    ]
    for value, title, desc in modes:
        box = ttk.LabelFrame(body, text=title)
        box.grid(row=row, column=0, sticky="ew", padx=12, pady=4)
        rb = ttk.Radiobutton(box, text=desc, value=value, variable=self.mode_var, command=lambda v=value: self.apply_mode(v), style="Compact.TRadiobutton")
        rb.pack(anchor="w", padx=12, pady=8)
        self.tip(rb, desc)
        row += 1

    website_box = ttk.LabelFrame(body, text="Website Recording Filters")
    website_box.grid(row=row, column=0, sticky="ew", padx=12, pady=4)
    ttk.Label(website_box, text="Choose exactly which browser actions the Smart Capture helper records. These filters do not change normal Windows recording. Regenerate the Browser Capture Helper after changing defaults.", style="Help.TLabel", wraplength=900, justify="left").pack(anchor="w", padx=12, pady=(8, 4))

    checks_wrap = ttk.Frame(website_box, style="Panel.TFrame")
    checks_wrap.pack(anchor="w", padx=12, pady=(2, 2))
    columns = [ttk.Frame(checks_wrap, style="Panel.TFrame") for _ in range(2)]
    for i, col in enumerate(columns):
        col.grid(row=0, column=i, sticky="nw", padx=(0 if i == 0 else 34, 0))
    website_checks = [
        ("Clicks", self.website_clicks_var, "Record semantic website click actions such as buttons and links."),
        ("Scroll", self.website_scroll_var, "Record page or scrollable-element scroll positions."),
        ("Click location", self.website_click_location_var, "Include x/y coordinates with click records. Turn this off for semantic-only website clicks."),
        ("Text input", self.website_input_var, "Record the final value of non-sensitive text fields. Password, token, secret, OTP, and similar fields are always blocked."),
        ("Selections", self.website_selection_var, "Record dropdown selections and checkbox/radio state changes."),
    ]
    for i, (label, var, hint) in enumerate(website_checks):
        target = columns[0] if i < 3 else columns[1]
        cb = ttk.Checkbutton(target, text=label, variable=var, command=self.save_vars, style="Compact.TCheckbutton")
        cb.pack(anchor="w", pady=3)
        self.tip(cb, hint)
    ttk.Label(website_box, text="Text input is OFF by default for privacy. Sensitive credential/security fields are never recorded.", style="Warn.TLabel", wraplength=900, justify="left").pack(anchor="w", padx=12, pady=(4, 6))
    presets = ttk.Frame(website_box, style="Panel.TFrame")
    presets.pack(anchor="w", padx=10, pady=(0, 9))
    for label, preset in [("All Safe", "all_safe"), ("Clicks Only", "clicks_only"), ("Click + Location", "click_location"), ("Scroll Only", "scroll_only"), ("Input Only", "input_only"), ("Selection Only", "selection_only")]:
        ttk.Button(presets, text=label, command=lambda p=preset: self.set_website_capture_preset(p)).pack(side="left", padx=3)
    row += 1

    calendar_box = ttk.LabelFrame(body, text="Calendar + Dynamic Dates")
    calendar_box.grid(row=row, column=0, sticky="ew", padx=12, pady=4)
    calendar_box.columnconfigure(0, weight=1)
    ttk.Label(calendar_box, text="Use a TODAY rule when a calendar step should select the actual current date every time instead of replaying the date originally recorded.", style="Help.TLabel", wraplength=740, justify="left").grid(row=0, column=0, sticky="w", padx=12, pady=8)
    cal_btn = ttk.Button(calendar_box, text="Open Calendar Guide", style="Accent.TButton", command=self.show_calendar_guide)
    cal_btn.grid(row=0, column=1, sticky="e", padx=12, pady=8)
    self.tip(cal_btn, "Open step-by-step instructions for Windows/native calendars and website date pickers.")
    row += 1

    smart_box = ttk.LabelFrame(body, text="Smart Target Recognition")
    smart_box.grid(row=row, column=0, sticky="ew", padx=12, pady=4)
    cbwrap = ttk.Frame(smart_box, style="Panel.TFrame")
    cbwrap.pack(anchor="w", padx=12, pady=7)
    st1 = ttk.Checkbutton(cbwrap, text="Record Windows UI Automation target details", variable=self.smart_target_var, command=self.save_vars, style="Compact.TCheckbutton")
    st1.grid(row=0, column=0, sticky="w", padx=(0, 30), pady=3)
    self.tip(st1, "On clicks, try to record the actual Windows control name/type/AutomationId instead of relying only on coordinates.")
    st2 = ttk.Checkbutton(cbwrap, text="Try semantic target first during playback", variable=self.smart_playback_var, command=self.save_vars, style="Compact.TCheckbutton")
    st2.grid(row=0, column=1, sticky="w", pady=3)
    self.tip(st2, "For recognized Windows controls, try UI Automation invoke/select before falling back to physical coordinates.")
    st3 = ttk.Checkbutton(cbwrap, text="Detect / allow dynamic Calendar TODAY rules", variable=self.calendar_today_var, command=self.save_vars, style="Compact.TCheckbutton")
    st3.grid(row=1, column=0, columnspan=2, sticky="w", pady=3)
    self.tip(st3, "Lets calendar clicks be marked TODAY so future runs search for today's date rather than reusing the date originally recorded.")
    row += 1

    lower = ttk.Frame(body, style="Panel.TFrame")
    lower.grid(row=row, column=0, sticky="ew", padx=12, pady=4)
    ttk.Label(lower, text="Run behavior", style="Panel.TLabel").grid(row=0, column=0, sticky="w", padx=(0, 12), pady=4)
    run_box = ttk.Combobox(lower, textvariable=self.run_behavior_var, values=["manual", "after_save", "on_start"], state="readonly", width=18)
    run_box.grid(row=0, column=1, sticky="w", pady=4)
    self.tip(run_box, "Manual waits for you to press Play. After Save can replay a recording after it is saved. On Start can load/run the last recording at app launch.")
    row += 1

    safety = ttk.LabelFrame(body, text="Playback Safety")
    safety.grid(row=row, column=0, sticky="ew", padx=12, pady=4)
    validate = ttk.Checkbutton(safety, text="Validate target before click/scroll", variable=self.target_validation_var, command=self.save_vars, style="Compact.TCheckbutton")
    validate.pack(anchor="w", padx=12, pady=(8, 2))
    self.tip(validate, "Compare the recorded process/window with the current foreground target before a click or scroll.")
    pause_target = ttk.Checkbutton(safety, text="Pause if target changes", variable=self.pause_target_var, command=self.save_vars, style="Compact.TCheckbutton")
    pause_target.pack(anchor="w", padx=12, pady=(2, 8))
    self.tip(pause_target, "Pause playback instead of clicking into the wrong application when target validation detects a change.")
    row += 1

    buttons = ttk.Frame(body, style="Panel.TFrame")
    buttons.grid(row=row, column=0, sticky="w", padx=12, pady=(5, 6))
    ttk.Button(buttons, text="Create Browser Capture Helper", command=self.create_browser_helper).pack(side="left", padx=4)
    ttk.Button(buttons, text="Open Website Actions Folder", command=lambda: open_folder(WEBSITE_ACTIONS_DIR)).pack(side="left", padx=4)
    row += 1

    note = "Physical replay controls the active desktop. For true simultaneous work, use browser element automation, a VM, Remote Desktop, another Windows session, or another PC."
    ttk.Label(body, text=note, style="Warn.TLabel", wraplength=900, justify="left").grid(row=row, column=0, sticky="w", padx=12, pady=(2, 10))


def _v141_show_calendar_guide(self):
    self.current_screen.set("Calendar Guide")
    self.clear_content()
    outer = self.scroll_frame(self.panel())
    outer.columnconfigure(0, weight=1)
    body = ttk.Frame(outer, style="Panel.TFrame")
    body.grid(row=0, column=0, pady=6)
    body.columnconfigure(0, weight=1)

    today = datetime.date.today()
    today_display = today.strftime("%A, %B %d, %Y")

    ttk.Label(body, text="Calendar + Dynamic Date Guide", style="Section.TLabel").grid(row=0, column=0, sticky="w", padx=12, pady=(6, 2))
    ttk.Label(body, text=f"Use dynamic calendar rules when a recording must choose the date that is current when it runs. Today's test date is: {today_display}.", style="Help.TLabel", wraplength=920, justify="left").grid(row=1, column=0, sticky="w", padx=12, pady=(0, 6))

    sections = [
        ("Why not use coordinates?", "A calendar changes position as months change. Clicking the same x/y coordinate tomorrow or next month can choose the wrong day. The TODAY rule stores the intention 'select today's date' and searches for the date again during replay."),
        ("Windows / native application calendar", "1. Record yourself opening the calendar and clicking the date. 2. Open Smart Targets + Actions. 3. Select the recognized date click. 4. Click Mark Selected = TODAY. 5. Click Save Edited Copy. 6. On future replay, Windows UI Automation searches the current target window for today's accessible date label. If the app was closed and reopened, Rice2k Macro Studio can re-find the window by process/title instead of depending only on the old HWND."),
        ("Website calendar / date picker", "1. Open Automation and create the Browser Element Capture helper. 2. Start the Rice2k Macro Studio Smart Capture bookmarklet on the website. 3. Open the date picker. 4. Click Mark Next = TODAY in the floating capture panel. 5. Click today's date. 6. Download or copy the capture JSON. 7. The browser replay recalculates today's date and looks for semantic date attributes/labels instead of the original coordinate."),
        ("How website TODAY detection works", "The browser helper checks strong signals first: aria-current='date', data-date='YYYY-MM-DD', datetime='YYYY-MM-DD', time[datetime], accessible labels/titles containing today's month/day/year, and then a calendar-scoped day-number fallback. If the calendar provides a clear Today/Current Date control, that can also be used."),
        ("How Windows TODAY detection works", "Windows smart-target playback first resolves the current application window. It then scores UI Automation descendants by today's accessible date label, control type and class. A bare day number such as '16' is only used as a fallback when it is unique among compatible controls."),
        ("If TODAY cannot be found", "The app should not guess blindly. Open the calendar manually and inspect Smart Targets. Make sure Windows UI Automation is available, or use Browser Element Capture for websites. Some custom-drawn calendars expose no accessible date information; those may require coordinate playback."),
        ("Recurring calendar jobs", "TODAY is useful for 'pick today's date'. A future enhancement can use rules such as TOMORROW, +N days, first/last day of month, next weekday, or a date from a field."),
    ]
    row = 2
    for title, desc in sections:
        box = ttk.LabelFrame(body, text=title)
        box.grid(row=row, column=0, sticky="ew", padx=12, pady=4)
        ttk.Label(box, text=desc, style="Help.TLabel", wraplength=900, justify="left").pack(anchor="w", padx=12, pady=10)
        row += 1

    test_box = ttk.LabelFrame(body, text="Calendar TODAY Self-Test")
    test_box.grid(row=row, column=0, sticky="ew", padx=12, pady=5)
    test_box.columnconfigure(1, weight=1)
    b_test = ttk.Button(test_box, text="Run Calendar Test", style="Accent.TButton", command=self.run_calendar_today_test)
    b_test.grid(row=0, column=0, sticky="w", padx=12, pady=10)
    self.tip(b_test, "Test the app's current-date label matching and report whether Windows UI Automation is available.")
    ttk.Label(test_box, textvariable=self.calendar_test_var, style="Panel.TLabel", wraplength=700, justify="left").grid(row=0, column=1, sticky="w", padx=12, pady=10)
    row += 1

    buttons = ttk.Frame(body, style="Panel.TFrame")
    buttons.grid(row=row, column=0, sticky="w", padx=12, pady=(4, 14))
    ttk.Button(buttons, text="Open Smart Targets", command=self.show_smart_actions).pack(side="left", padx=4)
    ttk.Button(buttons, text="Create Browser Helper", command=self.create_browser_helper).pack(side="left", padx=4)
    ttk.Button(buttons, text="Open Website Actions Folder", command=lambda: open_folder(WEBSITE_ACTIONS_DIR)).pack(side="left", padx=4)


def _v141_show_settings(self):
    self.current_screen.set("Settings")
    self.clear_content()
    outer = self.scroll_frame(self.panel())
    outer.columnconfigure(0, weight=1)
    body = ttk.Frame(outer, style="Panel.TFrame")
    body.grid(row=0, column=0, pady=6)
    body.columnconfigure(1, weight=1)
    ttk.Label(body, text="Settings", style="Section.TLabel").grid(row=0, column=0, columnspan=2, sticky="w", padx=12, pady=(6, 2))
    self.help_text(body, "Customize appearance, countdown, timing behavior, and global hotkeys. Hotkeys must be unique.", 1, columnspan=2, wrap=920)
    ttk.Label(body, text="Theme", style="Panel.TLabel").grid(row=2, column=0, sticky="w", padx=12, pady=4)
    theme_box = ttk.Combobox(body, textvariable=self.theme_var, values=["dark", "neo_green", "light"], state="readonly", width=16)
    theme_box.grid(row=2, column=1, sticky="w", padx=12, pady=6)
    self.tip(theme_box, "Dark = default navy UI. Neo Green = black / neon green. Light = softened light theme without harsh white panels. Full theme refresh occurs on next app launch.")
    ttk.Label(body, text="Countdown", style="Panel.TLabel").grid(row=3, column=0, sticky="w", padx=12, pady=4)
    countdown_box = ttk.Spinbox(body, from_=0, to=30, textvariable=self.countdown_var, width=8, command=self.save_vars)
    countdown_box.grid(row=3, column=1, sticky="w", padx=12, pady=6)
    self.tip(countdown_box, "Seconds to count down before playback begins, giving you time to switch to the target window.")
    ttk.Checkbutton(body, text="Human-like small timing variation", variable=self.human_like_var, command=self.save_vars, style="Compact.TCheckbutton").grid(row=4, column=0, columnspan=2, sticky="w", padx=12, pady=4)
    ttk.Separator(body).grid(row=5, column=0, columnspan=2, sticky="ew", padx=18, pady=10)
    ttk.Label(body, text="Hotkeys", style="Section.TLabel").grid(row=6, column=0, columnspan=2, sticky="w", padx=12, pady=4)
    choices = ["f5", "f6", "f7", "f8", "f9", "f10", "f11", "f12", "esc"]
    row = 7
    for name, label in [("start", "Start"), ("stop", "Stop + Save"), ("pause", "Pause / Resume"), ("play", "Play"), ("emergency", "Emergency Stop")]:
        ttk.Label(body, text=label, style="Panel.TLabel").grid(row=row, column=0, sticky="w", padx=12, pady=4)
        hotkey_box = ttk.Combobox(body, textvariable=self.hotkey_vars[name], values=choices, state="readonly", width=10)
        hotkey_box.grid(row=row, column=1, sticky="w", padx=12, pady=5)
        self.tip(hotkey_box, f"Global hotkey assigned to {label}. Each action must use a unique key.")
        row += 1
    ttk.Button(body, text="Save Settings + Restart Hotkeys", command=self.save_and_restart_hotkeys).grid(row=row, column=0, sticky="ew", padx=18, pady=10)
    ttk.Button(body, text="Open App Folder", command=lambda: open_folder(APP_DIR)).grid(row=row, column=1, sticky="ew", padx=18, pady=10)
    row += 1
    ttk.Label(body, text="Theme changes apply fully the next time the app opens.", style="Help.TLabel").grid(row=row, column=0, columnspan=2, sticky="w", padx=18, pady=(0, 10))


def _v13_build_style(self):
    c = self.colors()
    self.configure(bg=c["bg"])
    self.option_add("*Font", (self.ui_font, 10))
    self.option_add("*TCombobox*Listbox.font", (self.ui_font, 10))
    self.option_add("*Listbox.font", (self.ui_font, 10))

    self.style = ttk.Style()
    try:
        self.style.theme_use("clam")
    except Exception:
        pass

    base = (self.ui_font, 10)
    small = (self.ui_font, 9)
    bold = (self.ui_font, 10, "bold")

    self.style.configure("TFrame", background=c["bg"])
    self.style.configure("Panel.TFrame", background=c["panel"])
    self.style.configure("Panel2.TFrame", background=c["panel2"])
    self.style.configure("TLabel", background=c["bg"], foreground=c["text"], font=base)
    self.style.configure("Panel.TLabel", background=c["panel"], foreground=c["text"], font=base)
    self.style.configure("Panel2.TLabel", background=c["panel2"], foreground=c["text"], font=base)
    self.style.configure("Header.TLabel", background=c["bg"], foreground=c["text"], font=(self.ui_font, 22, "bold"))
    self.style.configure("Sub.TLabel", background=c["bg"], foreground=c["sub"], font=small)
    self.style.configure("Status.TLabel", background=c["panel"], foreground=c["accent"], font=(self.ui_font, 11, "bold"))
    self.style.configure("Warn.TLabel", background=c["panel"], foreground=c["warning"], font=bold)
    self.style.configure("Success.TLabel", background=c["panel"], foreground=c["success"], font=bold)
    self.style.configure("Help.TLabel", background=c["panel"], foreground=c["sub"], font=small)
    self.style.configure("Section.TLabel", background=c["panel"], foreground=c["text"], font=(self.ui_font, 12, "bold"))
    self.style.configure("Footer.TLabel", background=c["panel2"], foreground=c["sub"], font=small)

    def map_button(name, normal, hover, pressed, fg, pad=(10, 7), font=None):
        self.style.configure(
            name, font=font or bold, padding=pad, background=normal, foreground=fg,
            bordercolor=c["border"], focusthickness=1, focuscolor=c["border"]
        )
        self.style.map(
            name,
            background=[
                ("disabled", c["disabled_bg"]), ("pressed", pressed),
                ("active", hover), ("focus", hover)
            ],
            foreground=[
                ("disabled", c["disabled_fg"]), ("pressed", fg),
                ("active", fg), ("focus", fg)
            ],
            bordercolor=[
                ("active", c["accent"]), ("focus", c["accent"]), ("pressed", pressed)
            ],
        )

    map_button("TButton", c["panel3"], c["card_alt"], c["select_bg"], c["text"], pad=(10, 6), font=base)
    primary_fg = "#06130A" if self.theme_var.get() == "neo_green" else "#FFFFFF"
    map_button("Primary.TButton", c["accent"], c["accent_hover"], c["accent_pressed"], primary_fg, pad=(12, 9))
    map_button("Accent.TButton", c["accent2"], c["accent_hover"], c["accent_pressed"], "#06131F", pad=(10, 7))
    map_button("Danger.TButton", c["danger"], c["danger_hover"], "#D72B3A", "#FFFFFF", pad=(10, 7))

    self.style.configure("TCheckbutton", background=c["card"], foreground=c["text"], font=base, padding=(2, 2), focusthickness=0)
    self.style.map("TCheckbutton", background=[("active", c["card"]), ("focus", c["card"]), ("disabled", c["card"])], foreground=[("disabled", c["disabled_fg"]), ("active", c["text"]), ("focus", c["text"])], indicatorcolor=[("selected", c["accent"]), ("!selected", c["input_bg"]), ("disabled", c["disabled_bg"])])
