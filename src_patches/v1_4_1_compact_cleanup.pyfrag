# Rice2k Macro Studio v1.4.1 Compact Cleanup patch
# Adds Neo Green, softens Light, tightens Dashboard/sidebar/options, and centers major content pages.

APP_VERSION = "1.4.1 Compact Cleanup"

THEMES.clear()
THEMES.update({
    "dark": {
        "bg": "#08111F", "panel": "#0D1A2B", "panel2": "#0A1625",
        "panel3": "#10243A", "card": "#0F1E31", "text": "#EEF5FF", "sub": "#94B1D0",
