        test_box = ttk.LabelFrame(f, text="Calendar TODAY Self-Test")
        test_box.grid(row=row, column=0, sticky="ew", padx=18, pady=8)
        test_box.columnconfigure(1, weight=1)
        b_test = ttk.Button(test_box, text="Run Calendar Test", style="Accent.TButton", command=self.run_calendar_today_test)
        b_test.grid(row=0, column=0, sticky="w", padx=12, pady=10)
        self.tip(b_test, "Test the app's current-date label matching and report whether Windows UI Automation is available.")
        ttk.Label(test_box, textvariable=self.calendar_test_var, style="Panel.TLabel", wraplength=700, justify="left").grid(row=0, column=1, sticky="w", padx=12, pady=10)
        row += 1

        buttons = ttk.Frame(f, style="Panel.TFrame")
        buttons.grid(row=row, column=0, sticky="ew", padx=18, pady=(4, 16))
        ttk.Button(buttons, text="Open Smart Targets", command=self.show_smart_actions).pack(side="left", padx=4)
        ttk.Button(buttons, text="Create Browser Helper", command=self.create_browser_helper).pack(side="left", padx=4)
        ttk.Button(buttons, text="Open Website Actions Folder", command=lambda: open_folder(WEBSITE_ACTIONS_DIR)).pack(side="left", padx=4)

    def run_calendar_today_test(self):
        try:
            today = datetime.date.today()
            variants = sorted(today_label_variants(today))
            test_inputs = [
                today.isoformat(),
                f"{today.strftime('%B')} {today.day}, {today.year}",
                f"{today.strftime('%A')}, {today.strftime('%B')} {today.day}, {today.year}",
                today.strftime("%m/%d/%Y"),
            ]
            matching = all(looks_like_today_label(x, today) for x in test_inputs)
            uia_status = "available" if (Desktop is not None and sys.platform.startswith("win")) else (
                "not available on this system" if sys.platform.startswith("win") else "Windows-only; not testable on this OS"
            )
            status = (
                f"{'PASS' if matching else 'FAIL'} — date-label matching; "
                f"Windows UI Automation: {uia_status}. "
                f"Today: {today.isoformat()} | examples recognized: {', '.join(test_inputs[:3])}"
            )
            self.calendar_test_var.set(status)
            self.add_log("Calendar TODAY self-test: " + status)
        except Exception as exc:
            log_error("run_calendar_today_test", exc)
            self.calendar_test_var.set(f"FAIL — {exc}")


    def show_diagnostics(self):
        self.current_screen.set("Diagnostics")
        self.clear_content()
        f = self.scroll_frame(self.panel())
        f.columnconfigure(1, weight=1)

        ttk.Label(f, text="Diagnostics + Calibration", style="Panel.TLabel", font=("Segoe UI", 16, "bold")).grid(row=0, column=0, columnspan=2, sticky="w", padx=18, pady=(14, 4))
        self.help_text(
            f,
            "Run Pre-flight before important playback. Calendar TODAY Test checks current-date matching. Calibration offsets shift coordinate fallback clicks when display scaling creates a consistent offset.",
            1, columnspan=2
        )

        preflight_btn = ttk.Button(f, text="Run Pre-flight Test", style="Accent.TButton", command=self.run_preflight)
        preflight_btn.grid(row=2, column=0, sticky="ew", padx=18, pady=8)
        self.tip(preflight_btn, "Check dependencies, hotkeys, target metadata, UI Automation availability, and display layout.")
        ttk.Label(f, textvariable=self.preflight_var, style="Panel.TLabel", wraplength=700, justify="left").grid(row=2, column=1, sticky="w", padx=12, pady=8)

        cal_test = ttk.Button(f, text="Run Calendar TODAY Test", command=self.run_calendar_today_test)
        cal_test.grid(row=3, column=0, sticky="ew", padx=18, pady=8)
